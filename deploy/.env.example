# Production environment for deploy/docker-compose.prod.yml.
# Copy this to deploy/.env on the VM and fill in real values - deploy/.env is
# gitignored (matched by the repo-wide ".env" rule) and must never be committed.

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend (required, no default in the prod profile) ---
# Generate locally, e.g. on PowerShell:
# [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
EMAIL_PASSWORD=
# Where the frontend runs - verification/password-reset emails link here. Must
# be the full path GitHub Pages serves the project at (not just the origin) -
# EmailService concatenates this directly with "/verify-email?token=...".
FRONTEND_URL=https://hernanisamuel.github.io/munehisa-investment-simulator

# --- Backend (optional, already defaulted to the GitHub Pages origin) ---
# CORS is origin-only (no path) by design - the browser's Origin header never
# includes one, so this default is correct as-is regardless of FRONTEND_URL above.
# CORS_ALLOWED_ORIGINS=https://hernanisamuel.github.io

# --- Backend <-> data-service shared secret (must be the same value on both sides) ---
# Generate locally, e.g. on PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
DATA_SERVICE_API_KEY=

# --- Backend (optional overrides - defaults defined in application.properties) ---
# JWT_EXPIRATION=3600000
# VERIFICATION_TOKEN_EXPIRATION=1800000
# RESET_TOKEN_EXPIRATION=900000
# MAX_ATTEMPTS=5
# LOCK_TIME=900000
# UNKNOWN_EMAIL_THROTTLE_MAX_ATTEMPTS=5
# UNKNOWN_EMAIL_THROTTLE_WINDOW=900000
# UNKNOWN_EMAIL_THROTTLE_MAX_TRACKED_EMAILS=10000
# INFLATION_REFRESH_THRESHOLD_DAY=20
# ASSET_ORPHAN_GRACE_PERIOD_DAYS=7

# --- Caddy / DuckDNS ---
# The DuckDNS subdomain pointed at the VM's public IP (see deploy/README.md).
DUCKDNS_DOMAIN=your-subdomain.duckdns.org
# Only used by Caddy to register with Let's Encrypt (renewal/expiry notices) -
# not exposed publicly.
CADDY_ACME_EMAIL=you@example.com
