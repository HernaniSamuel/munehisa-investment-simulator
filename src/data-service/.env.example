# Shared secret the Java backend sends as the X-API-Key header on every request.
# Generate one locally, e.g. on PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
DATA_SERVICE_API_KEY=

# Optional override (default: 8001)
# DATA_SERVICE_PORT=8001

# Optional override (default: 127.0.0.1, loopback-only). The Docker image sets this to
# 0.0.0.0 itself - only override it directly if you're binding wider outside a container.
# DATA_SERVICE_HOST=127.0.0.1
