EMAIL_PASSWORD=

# generated locally on powershell using [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

# Optional overrides (defaults defined in application.properties, values in ms)
# JWT_EXPIRATION=3600000
# VERIFICATION_TOKEN_EXPIRATION=1800000
# RESET_TOKEN_EXPIRATION=900000

# Where the frontend runs - verification/password-reset emails link here.
# Defaults to http://localhost:5173 (Vite's default dev port).
# FRONTEND_URL=http://localhost:5173

# Swagger UI / OpenAPI docs - on by default in the dev profile already, no
# need to set this to see it locally. Uncomment to force it off even in dev.
# SWAGGER_UI_ENABLED=false

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# pgAdmin
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=

# password rate limit (max attempts in int, lock time in ms)
MAX_ATTEMPTS=
LOCK_TIME=

# throttle for login attempts against emails with no matching account (issue
# #26) - max attempts in int, window/TTL in ms, max distinct tracked emails in int
UNKNOWN_EMAIL_THROTTLE_MAX_ATTEMPTS=
UNKNOWN_EMAIL_THROTTLE_WINDOW=
UNKNOWN_EMAIL_THROTTLE_MAX_TRACKED_EMAILS=

# Data-service integration: shared secret sent as X-API-Key, must match
# DATA_SERVICE_API_KEY in data-service/.env
DATA_SERVICE_API_KEY=

# Optional override (defaults to http://127.0.0.1:8001, data-service's default port)
# DATA_SERVICE_BASE_URL=http://127.0.0.1:8001

# Day of month (1-31) from which a missing current-month inflation row
# triggers a lazy re-fetch of the full series. Optional, defaults to 20.
# INFLATION_REFRESH_THRESHOLD_DAY=20